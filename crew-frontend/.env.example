# Legacy local backend (also used when CREW_API_ORIGIN is unset).
CREW_API_ORIGIN=http://127.0.0.1:3001

# Customer-development stand: Backoffice 3030, backend 3031, Crew 3032.
# CREW_API_ORIGIN=http://127.0.0.1:3031
# Set this server-only value in .env.local and restart Crew.
# Start Crew with: node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3032
# Sign in again after switching stands; sessions belong to their backend database.
