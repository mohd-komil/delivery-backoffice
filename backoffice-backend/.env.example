# Generated by scripts/postgres-setup.ps1. Placeholders only.
DATABASE_URL=postgresql://delivery_app:GENERATED_PASSWORD@127.0.0.1:55432/delivery_backoffice
TEST_DATABASE_URL=postgresql://delivery_app:GENERATED_PASSWORD@127.0.0.1:55432/delivery_backoffice_test
ODOO_DATABASE_URL=postgresql://odoo_reader:GENERATED_PASSWORD@127.0.0.1:55432/odoo_mock
# Existing demo source stays selected unless an external source is explicitly configured.
ODOO_SOURCE_MODE=mock
ODOO_SOURCE_INSTANCE=odoo_mock
# Separate Odoo 18 integration runtime: placeholders only; keep actual credentials in ignored local files.
# Keep DATABASE_URL and TEST_DATABASE_URL on their named isolated databases above.
# ODOO_SOURCE_MODE=odoo18
# ODOO_SOURCE_INSTANCE=customer-development-copy
# ODOO_DATABASE_URL=postgresql://source_reader:GENERATED_PASSWORD@source.example.test:15433/customer_snapshot
# ODOO_SOURCE_ALLOWED_ENDPOINT=postgresql://source.example.test:15433/customer_snapshot
# ODOO_SOURCE_USER=source_reader
# TLS verifies the source certificate by default; optionally provide a trusted CA file.
# ODOO_SOURCE_TRANSPORT=tls
# ODOO_SOURCE_CA_FILE=C:/certificates/source-ca.pem
# internal-lan is an explicit local-test exception requiring approval, limited to an exact
# RFC1918 IPv4 or .local endpoint. It is not encrypted; do not use it for production.
# ODOO_SOURCE_TRANSPORT=internal-lan
# Separate integration UI origins (allowed only with ODOO_SOURCE_MODE=odoo18):
# FRONTEND_ORIGIN=http://127.0.0.1:3030
# CREW_FRONTEND_ORIGIN=http://127.0.0.1:3032
PORT=3001
# Enable explicitly after applying route publication/lifecycle migrations and verifying the local lifecycle.
ROUTE_PUBLICATION_ENABLED=false
FRONTEND_ORIGIN=http://127.0.0.1:3000
CREW_FRONTEND_ORIGIN=http://127.0.0.1:3002
# Optional backend-only geocoding settings file; contains {"apiKey":"...","dailyLimit":100}.
# Keep the actual file outside version control. Never use NEXT_PUBLIC_ for this key.
# GEOAPIFY_SETTINGS_FILE=.local/maps/geoapify.json

