{
  "name": "delivery-backoffice-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:pilot": "tsx scripts/demo-pilot.ts",
    "demo:gianluca": "tsx scripts/demo-gianluca.ts",
    "demo:italian-participants": "tsx scripts/italian-participants.ts",
    "openapi": "tsx scripts/openapi.ts",
    "import": "tsx scripts/import.ts",
    "import:watch": "tsx scripts/import.ts --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "eslint": "^10.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
